{
  "name": "goldloan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GoldLoan – gold loan portal with an AI Loan Assist agent (TGlobal take-home assignment)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:pg": "node scripts/dev-pg.mjs",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "test": "npm run test -w packages/shared -w apps/api",
    "test:pg": "node scripts/test-pg.mjs",
    "eval": "tsx evals/run.ts",
    "typecheck": "npm run typecheck -w packages/shared -w apps/api -w apps/web",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:down": "docker compose down",
    "db:check:hf": "node scripts/db-check.mjs",
    "deploy:hf": "python scripts/deploy_hf.py"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
