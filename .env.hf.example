# Settings for the Hugging Face Space – used by  npm run deploy:hf  (see docs/DEPLOY_HUGGINGFACE.md).
# Copy this file to .env.hf and fill it in. .env.hf is git-ignored: never commit it.
# deploy:hf stores DATABASE_URL and LLM_API_KEY as encrypted Space secrets.

# Hosted PostgreSQL – Hugging Face does not host databases. Free option: https://neon.tech
# Paste the full connection string, e.g. postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# AI assistant – same as in .env (Gemini free tier by default)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
