# ───────────────────────────────────────────────────────────────
# Gold Loan Portal – environment variables
# Copy to .env and adjust. Never commit the real .env file.
# ───────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Browser origin allowed by CORS (the Vite dev server proxies /api, so this is optional in dev)
WEB_ORIGIN=http://localhost:5173

# ── Database ────────────────────────────────────────────────────
# auto     → PostgreSQL when DATABASE_URL is set, otherwise in-memory (data lost on restart)
# postgres → always PostgreSQL (fails fast if DATABASE_URL is missing)
# memory   → always in-memory (zero setup, used by the tests)
DB_DRIVER=auto
# Easiest: `npm run dev:pg` starts the PostgreSQL container from docker-compose.yml and uses it – no edit needed.
# To use PostgreSQL with plain `npm run dev`, run `npm run db:up` once and uncomment this line.
# Migrations and the plan seed run automatically when the API starts.
# DATABASE_URL=postgresql://gold:gold@localhost:5432/goldloan

# ── Business configuration ──────────────────────────────────────
# Mock 24K gold rate in rupees per gram (assignment value: 7000)
MOCK_GOLD_RATE_24K_RUPEES=7000
# How long the gold-rate provider caches a value (ms)
GOLD_RATE_CACHE_TTL_MS=60000
# Rate limits (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LEADS_MAX=20
RATE_LIMIT_CHAT_MAX=40

# ── AI agent (all LLM calls happen on the server; keys never reach the browser) ──
# auto      → anthropic if ANTHROPIC_API_KEY is set, else openai-compatible if OPENAI_API_KEY is set,
#             else the deterministic offline assistant (no key needed)
# anthropic | openai | offline
LLM_PROVIDER=auto

# Anthropic (Claude) – get a key at https://console.anthropic.com. Called with the official SDK, server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# How hard the model thinks before answering: low | medium | high | xhigh | max. A chat wants quick replies.
ANTHROPIC_EFFORT=low

# OpenAI-compatible endpoints (OpenAI, Gemini free tier, Ollama, Groq, …)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Ollama (local, free):      OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama  OPENAI_MODEL=llama3.1
# Gemini (free tier):        OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  OPENAI_MODEL=gemini-2.0-flash

# Agent behaviour
AGENT_MAX_TOOL_STEPS=6
AGENT_SESSION_TTL_MS=1800000
LLM_TIMEOUT_MS=30000
