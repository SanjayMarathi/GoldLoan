# Gold Loan Portal – settings. Copy this file to .env and fill in what you need.
# Every line is optional: with nothing set, the app runs with in-memory data and the built-in offline assistant.
# Never commit .env (it is git-ignored).

# ── Database ───────────────────────────────────────────────────
# Empty = in-memory (data is lost on restart).
# Local Docker:  npm run dev:pg  sets this for you  (postgresql://gold:gold@localhost:5432/goldloan)
# Hosted:        paste the connection string from Neon / Supabase (ends with ?sslmode=require)
DATABASE_URL=

# ── AI assistant ───────────────────────────────────────────────
# Empty key = built-in offline assistant.
# Gemini (free): get a key at https://aistudio.google.com/apikey and keep the two lines below as they are.
# Claude (paid): LLM_BASE_URL=https://api.anthropic.com   LLM_MODEL=claude-opus-5-5
# Ollama (local, no key): LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
